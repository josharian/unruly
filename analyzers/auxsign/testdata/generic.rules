// The earlier rule leaves e in [0, 63]; nothing bounds c.
((Lsh64|Rsh64U)x64 _ (Const64 [c])) && uint64(c) >= 64 => (Const64 [0])
(Lsh64x64 (And64 (Rsh64x64 <t> x (Const64 <t2> [c])) (Const64 [d])) (Const64 [e])) && c >= e => (And64 (Rsh64x64 <t> x (Const64 <t2> [c-e])) (Const64 <t> [d<<e]))
(Lsh64x64 (And64 (Rsh64x64 <t> x (Const64 <t2> [c])) (Const64 [d])) (Const64 [e])) && c < e => (And64 (Lsh64x64 <t> x (Const64 <t2> [e-c])) (Const64 <t> [d<<e])) // want `Rsh64x64 reads c as unsigned, but c < e compares it as signed: c=-1 \(0xffffffffffffffff as a uint64\) satisfies it; compare uint64\(c\) or require c >= 0`
(Rsh64Ux64 (Rsh64Ux64 x (Const64 [c])) (Const64 [d])) && c >= 0 && c < 64 && d < 64 - c => (Rsh64Ux64 x (Const64 <typ.UInt64> [c+d]))
(Rsh64x64 (Rsh64x64 x (Const64 [c])) (Const64 [d])) && uint64(c) < 64 && uint64(d) < 64 => (Rsh64x64 x (Const64 <typ.UInt64> [c+d]))
