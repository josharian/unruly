// Re-issued loads (go.dev/issue/59973).
(BSWAPQ (MOVBEQload [i] {s} p m)) => (MOVQload [i] {s} p m) // want `load MOVBEQload is re-issued as MOVQload, but nothing proves it has no other uses`
(BSWAPL x:(MOVBELload [i] {s} p mem)) && x.Uses == 1 => @x.Block (MOVLload [i] {s} p mem)
(ADDQ x l:(MOVQload [off] {sym} ptr mem)) && canMergeLoadClobber(v, l, x) && clobber(l) => (ADDQload x [off] {sym} ptr mem)
(TESTQ l:(MOVQload {sym} [off] ptr mem) l2) && l == l2 && l.Uses == 2 && clobber(l) => @l.Block (CMPQconstload {sym} [makeValAndOff(0, off)] ptr mem)
(TESTL l:(MOVLload {sym} [off] ptr mem) l2) && l == l2 && clobber(l) => @l.Block (CMPLconstload {sym} [makeValAndOff(0, off)] ptr mem) // want `load l \(MOVLload\) is re-issued as CMPLconstload, but the condition doesn't establish l.Uses == 2` `Clobber\(l\) without l.Uses == 2`

// Lowering through each selector duplicates the side effect (CL 27991).
(Select0 <t> (AtomicAdd32 ptr val mem)) => (ADDL (Select0 <t> (XADDLlock val ptr mem)) val) // want `result creates memory op XADDLlock from AtomicAdd32`
(Select1 a:(LoweredAtomicAnd64 ptr val mem)) && a.Uses == 1 && clobber(a) => (ANDQlock ptr val mem)

// A live intermediate keeps a dying load live (217c284995).
(ORL x0:(MOVBload [i] {s} p mem) (SHLLconst [8] x1:(MOVBload [i+1] {s} p mem))) && x0.Uses == 1 && x1.Uses == 1 && clobber(x0, x1) => @x1.Block (MOVWload [i] {s} p mem) // want `load x1 \(MOVBload\) is re-issued as MOVWload from under SHLLconst, but SHLLconst is unnamed`
(ORL x0:(MOVBload [i] {s} p mem) s0:(SHLLconst [8] x1:(MOVBload [i+1] {s} p mem))) && x0.Uses == 1 && x1.Uses == 1 && clobber(x0, x1) => @x1.Block (MOVWload [i] {s} p mem) // want `from under s0 \(SHLLconst\), but the condition doesn't establish s0.Uses == 1`
(ORL x0:(MOVBload [i] {s} p mem) s0:(SHLLconst [8] x1:(MOVBload [i+1] {s} p mem))) && x0.Uses == 1 && x1.Uses == 1 && s0.Uses == 1 && clobber(x0, x1, s0) => @x1.Block (MOVWload [i] {s} p mem)
