// Wrong: TST leaves V unchanged, and LT reads it.
(LT (CMPconst [0] l:(AND x y)) yes no) && l.Uses==1 => (LT (TST x y) yes no) // want `reads a flag TST leaves unchanged`

// Correct: LTnoov ignores V.
(LT (CMPconst [0] l:(AND x y)) yes no) && l.Uses==1 => (LTnoov (TST x y) yes no)

// This file has no canonicalization rule creating InvertFlags, so any
// compare may be inverted; absorbing InvertFlags into a noov block is wrong.
(LTnoov (InvertFlags cmp) yes no) => (GTnoov cmp yes no) // want `cmp = \(CMP`
