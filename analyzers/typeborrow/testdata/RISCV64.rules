// Lowering rules from which typeborrow derives that SLLI shifts left by a constant.
(Lsh64x64 x y) && shiftIsBounded(v) => (SLL x y)
(SLL x (MOVDconst [val])) => (SLLI [val&63] x)

// t is the type of a lowered Rsh8x64, which may be int8.
(SRAI <t> [x] (MOVBreg y)) && x >= 8 => (SRAI [63] (SLLI <t> [56] y)) // want `\(SLLI <t> \[56\] \.\.\.\) has only zeros in its type's bits: t is the type of the matched SRAI, which may be 8 bits wide`

// The condition establishes that t is wide enough.
(SRAI <t> [x] (MOVHreg y)) && x >= 16 && t.Size() == 8 => (SRAI [63] (SLLI <t> [48] y))

// A fixed type is not borrowed.
(SRAI [x] (MOVWreg y)) && x >= 32 => (SRAI [63] (SLLI <typ.Int64> [32] y))

// The shift leaves some of t's bits.
(SRLI <t> [c] (MOVBUreg x)) && c < 8 => (SRLI [56+c] (SLLI <t> [7] x))
