// Renamed variables.
(Neg64 (Neg64 x)) => x
(Neg64 (Neg64 y)) => y // want `rule \(Neg64 \(Neg64 y\)\) never fires: generic.rules:2, \(Neg64 \(Neg64 x\)\), matches first \(with the same result\)`

// Commuted args of a commutative op.
(Sub64 (Add64 x y) x) => y
(Sub64 (Add64 x y) y) => x // want "never fires: generic.rules:6"

// Equivalent conditions, after renaming.
(Mul64 (Const64 [c]) x) && c == 1 && x.Type.IsSigned() => x
(Mul64 (Const64 [d]) z) && d == 1 && z.Type.IsSigned() => z // want "never fires"

// A binding name used only once constrains nothing.
(Neg32 x:(Neg32 y)) => y
(Neg32 (Neg32 z)) => z // want "never fires"

// A more general earlier rule: its variable binds a subexpression,
// and a repeated variable is a special case of distinct ones.
(Sub32 (Neg32 x) y) => (Neg32 (Add32 <v.Type> x y))
(Sub32 (Neg32 x) x) => (Neg32 (Add32 <v.Type> x x)) // want "never fires: generic.rules:19"
(Sub32 x (Neg32 y)) => (Add32 x y)
(Sub32 (Const32 [c]) (Neg32 (Neg32 y))) => (Add32 (Const32 <v.Type> [c]) y) // want "never fires: generic.rules:21"

// Conditions implied by bounds, by the match, and by helpers that
// always return true.
(Lsh64x64 x (Const64 [c])) && c < 64 => (Const64 [7])
(Lsh64x64 x (Const64 [d])) && d >= 0 && d <= 63 => (Const64 [8]) // want "never fires"
(Rsh64x64 x y) && y.Op != OpConst64 => (Const64 [7])
(Rsh64x64 x (Neg64 y)) => (Const64 [8]) // want "never fires"
(Rsh64Ux64 x y) && ssa.Clobber(y) => (Const64 [7])
(Rsh64Ux64 x (Neg64 y)) && x.Uses == 1 => (Const64 [8]) // want "never fires"

// Not shadowed: different literal auxints, weaker conditions,
// conditions on unnamed subexpressions, or distinct values that
// must be the same.
(Lsh32x64 (Const32 [0]) _) => (Const32 [0])
(Lsh32x64 (Const32 [1]) _) => (Const32 [1])
(Lsh16x64 x (Const64 [c])) && c < 16 => (Const16 [7])
(Lsh16x64 x (Const64 [d])) && d < 17 => (Const16 [8])
(Rsh32x64 x y) && ssa.IsSamePtr(x, y) => (Const32 [7])
(Rsh32x64 x (Neg64 y)) && ssa.IsSamePtr(x, y) => (Const32 [8])
(Sub16 x x) => (Const16 [0])
(Sub16 (Neg16 x) (Neg16 x)) => (Const16 [0])
(Rsh16x64 x y) && y.Op == OpConst64 => (Const16 [7])
(Rsh16x64 x (Neg64 y)) => (Const16 [8])

// Expansions of one rule are reported individually.
(Com(64|32) (Com(64|32) x)) => x
(Com(64|32) (Com(64|32) y)) => y // want "Com64 .*never fires: generic.rules:48" "Com32 .*never fires: generic.rules:48"

// Block rules.
(If (Not cond) yes no) => (If cond no yes)
(If (Not c) a b) => (If c b a) // want "never fires"
