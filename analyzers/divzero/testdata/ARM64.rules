// A guard on the 64-bit value does not protect a 32-bit division.
(DIVW (MOVDconst [c]) (MOVDconst [d])) && d != 0 => (MOVDconst [int64(uint32(int32(c)/int32(d)))]) // want `int32\(c\) / int32\(d\) in the result divides by zero if int32\(d\) is 0`
(UDIVW (MOVDconst [c]) (MOVDconst [d])) && uint32(d) != 0 => (MOVDconst [int64(uint32(c)/uint32(d))])
