// Generic lowerings. Their archsimd signatures give the machine ops'
// output shapes: VPADDD writes Int32 elements, VPMADDWD Int32 elements from
// Int16 inputs, VPMOVDB Int8x16 from Int32x4.
(AddInt32x4 ...) => (VPADDD128 ...)
(AddInt32x16 ...) => (VPADDD512 ...)
(DotProductPairsInt16x8 ...) => (VPMADDWD128 ...)
(DotProductPairsInt16x32 ...) => (VPMADDWD512 ...)
(TruncToInt8Int32x4 ...) => (VPMOVDB128_128 ...)
(AbsInt8x16 ...) => (VPABSB128 ...)

// Lowering shapes.
(AddInt64x2 ...) => (VPADDQ256 ...) // want `lowering shape: Int64x2.Add returns Int64x2 \(128 bits\), but VPADDQ256 produces Vec256`
(EqualFloat32x16 x y) => (VPMOVMToVec32x16 (VCMPPS512 [0] x y))
(EqualFloat64x8 x y) => (VPMOVMToVec32x16 (VCMPPD512 [0] x y)) // want `Float64x8.Equal returns Mask64x8, but .* VPMOVMToVec32x16, which produces a Mask32x16`
(ExpandUint8x64 x mask) => (VPEXPANDBMasked512 x (VPMOVVec8x64ToM <types.TypeMask> mask))
(ExpandUint16x8 x mask) => (VPEXPANDWMasked128 x (VPMOVVec32x4ToM <types.TypeMask> mask)) // want `Uint16x8.Expand converts argument mask \(Go type Mask16x8\) to a K mask with VPMOVVec32x4ToM, which expects a Mask32x4`

// Zero-masking fusions.
(VMOVDQU32Masked128 (VPADDD128 x y) mask) => (VPADDDMasked128 x y mask)
(VMOVDQU16Masked128 (VPMADDWD128 x y) mask) => (VPMADDWDMasked128 x y mask) // want `VMOVDQU16Masked128 selects 16-bit lanes, but VPMADDWD writes 32-bit elements`
(VMOVDQU32Masked128 (VPMOVDB128_128 x) mask) => (VPMOVDBMasked128_128 x mask) // want `AsInt32x4\(\).Masked\(m\) selects 8-bit element i by m\[0 1 2 3 - - - - ...\] instead of m\[0 0 0 0 1 1 1 1 ...\] \(-: no lane of m\)`
(VMOVDQU8Masked128 (VPMOVDB128_128 x) mask) => (VPMOVDBMasked128_128 x mask)
(VMOVDQU32Masked256 (VPMOVDB128_128 x) mask) => (VPMOVDBMasked128_128 x mask) // want `never matches: VMOVDQU32Masked256 operates on Vec256 but VPMOVDB128_128 produces Vec128`

// Merging fusions.
(VPBLENDMDMasked512 dst (VPADDD512 x y) mask) => (VPADDDMasked512Merging dst x y mask)
(VPBLENDMWMasked512 dst (VPMADDWD512 x y) mask) => (VPMADDWDMasked512Merging dst x y mask) // want `VPBLENDMWMasked512 selects 16-bit lanes, but VPMADDWD writes 32-bit elements`

// Byte blends: only 8-bit fusions are sound.
(VPBLENDVB128 dst (VPABSB128 x) mask) && v.Block.CPUfeatures.HasFeature(ssa.CPUavx512) => (VPABSBMasked128Merging dst x (VPMOVVec8x16ToM <types.TypeMask> mask))
(VPBLENDVB128 dst (VPADDD128 x y) mask) && v.Block.CPUfeatures.HasFeature(ssa.CPUavx512) => (VPADDDMasked128Merging dst x y (VPMOVVec32x4ToM <types.TypeMask> mask)) // want `VPBLENDVB selects bytes, but VPMOVVec32x4ToM keeps only the top bit of each 32-bit lane .* ignores all but m\[3\] of each 4 bytes`
(VPBLENDVB128 dst (VPMADDWD128 x y) mask) && v.Block.CPUfeatures.HasFeature(ssa.CPUavx512) => (VPMADDWDMasked128Merging dst x y (VPMOVVec16x8ToM <types.TypeMask> mask)) // want `with m a Mask32x4 selects element i by m\[0 0 1 1\] instead of m\[0 1 2 3\]`

// Fused width: the fused op must have the wrapper's width.
(VPBLENDMDMasked128 dst (VPADDD128 x y) mask) => (VPADDDMasked256Merging dst x y mask) // want `fused width: VPBLENDMDMasked128 operates on Vec128, but the fused VPADDDMasked256Merging produces Vec256, so the Vec128 value is computed by a 256-bit instruction`
(VMOVDQU32Masked256 (VPADDD256 x y) mask) => (VPADDDMasked128 x y mask) // want `fused width: .* produces Vec128, so the upper 128 bits of the result are lost`
(VPBLENDMDMasked256 dst (VPADDD256 x y) mask) => (VPADDDMasked256Merging dst x y mask)

// Fused operands: the masked form takes the fallback, the op's
// arguments in order, and the mask. Only a reordering of distinct
// variables is reported.
(VPBLENDMDMasked128 dst (VPADDD128 x y) mask) => (VPADDDMasked128Merging x dst y mask) // want `fused operands: the masked VPADDDMasked128Merging takes the fallback dst, then VPADDD128's arguments in order and then the mask, dst x y, but the result passes x dst y`
(VMOVDQU32Masked128 (VPSUBD128 x y) mask) => (VPSUBDMasked128 y x mask) // want `fused operands: the masked VPSUBDMasked128 takes VPSUBD128's arguments in order and then the mask, x y, but the result passes y x`
(VMOVDQU32Masked128 l:(VPSLLD128const [c] x) mask) => (VPSLLDMasked128const [c] x mask)

// Fused masks: the fused op must mask as the wrapper does.
(VPBLENDMDMasked128 dst (VPADDD128 x y) mask) => (VPADDDMasked128Merging dst x y (VPMOVVec32x4ToM <types.TypeMask> (VPMOVMToVec32x4 <types.TypeVec128> mask)))
(VPBLENDMDMasked128 dst (VPADDD128 x y) mask) => (VPADDDMasked128Merging dst x y (VPMOVVec32x4ToM <types.TypeMask> (VPMOVMToVec64x2 <types.TypeVec128> mask))) // want `fused mask: VPBLENDMDMasked128 selects lane i by bit i of mask, but VPADDDMasked128Merging masks by \(VPMOVVec32x4ToM .*\), whose bit \d is \d when mask's is \d`

// A commutative op's first two arguments may be swapped.
(VPBLENDMDMasked128 dst (VPADDD128 x y) mask) => (VPADDDMasked128Merging dst y x mask)
(VMOVDQU32Masked128 (VPADDD128 x y) mask) => (VPADDDMasked128 y x mask)
(VPBLENDMDMasked128 dst (VPSLLD128const [c] x) mask) => (VPSLLDMasked128constMerging [c+0] dst x mask)

// A result other than the op's masked form is not a fusion: here both
// sides are mask ? z : 0.
(VPBLENDMDMasked128 (Zero128) z:(VPADDD128 x y) mask) => (VPBLENDMDMasked128 z (Zero128 <types.TypeVec128>) (KNOTB mask))

// Conditions on values are not modeled.
(VPBLENDMDMasked128 dst (VPSUBD128 x y) mask) && x == y => (VPSUBDMasked128Merging dst y x mask)
(VPBLENDMDMasked128 dst (VPADDD128 x y) (KANDB m n)) && m == n => (VPADDDMasked128Merging dst x y m)

// Not checked: a different operation, a fallback dropped or invented,
// a different auxint, an argument substituted, and a byte blend's mask
// other than through its granularity. These rules are wrong but not
// reported.
(VMOVDQU32Masked128 (VPSLLD128const [c] x) mask) => (VPSLLDMasked128const [c+1] x mask)
(VPBLENDMDMasked128 dst (VPADDD128 x y) (VPCMPD128 [4] p q)) => (VPADDDMasked128Merging dst p q (VPCMPD128 [4] p q))
(VPBLENDMDMasked128 dst (VPADDD128 x y) mask) => (VPSUBDMasked128Merging dst x y mask)
(VPBLENDMDMasked128 dst (VPADDD128 x y) mask) => (VPADDDMasked128 x y mask)
(VMOVDQU32Masked128 (VPADDD128 x y) mask) => (VPADDDMasked128Merging x x y mask)
(VPBLENDVB128 dst (VPADDB128 x y) mask) => (VPADDBMasked128Merging dst x y (VPMOVVec8x16ToM <types.TypeMask> (VPXOR128 <types.TypeVec128> mask mask)))

// Arguments may differ and still compute the same: a Go expression, an
// op, a substituted variable (x-x is y-y), or an auxint (shifts by 32
// to 63 all give 0). And a reordering is not reported if the mask never
// selects the op's value.
(VPBLENDMDMasked128 dst a:(VPADDD128 x y) mask) => (VPADDDMasked128Merging dst a.Args[0] y mask)
(VPBLENDMDMasked128 dst (VPADDD128 x y) mask) => (VPADDDMasked128Merging dst (VPAND128 <types.TypeVec128> x x) y mask)
(VPBLENDMDMasked128 dst (VPADDD128 (VPADDD128 x y) z) mask) => (VPADDDMasked128Merging dst (VPADDD128 <types.TypeVec128> y x) z mask)
(VPBLENDMDMasked128 dst (VPADDD128 x y) (VPCMPD128 [3] p q)) => (VPADDDMasked128Merging dst p q (VPCMPD128 [3] p q))
(VPBLENDMDMasked128 y (VPSUBD128 x x) mask) => (VPSUBDMasked128Merging y y y mask)
(VPBLENDMDMasked128 dst (VPSLLD128const [c] x) mask) && c >= 32 && c < 64 => (VPSLLDMasked128constMerging [c+32] dst x mask)
(VPBLENDMDMasked128 dst (VPSUBD128 x y) (VPCMPD128 [3] p q)) => (VPSUBDMasked128Merging x dst y (VPCMPD128 [3] p q))
(VPBLENDMDMasked128 dst (VPSUBD128 x y) (VPCMPD128 [4] p q)) => (VPSUBDMasked128Merging x dst y (VPCMPD128 [4] p q)) // want `fused operands: .* dst x y, but the result passes x dst y`

// A condition that reaches values through v.Block inspects them: here
// x == y.
(VPBLENDMDMasked128 dst (VPSUBD128 x y) mask) && len(v.Block.Values) == 1 && v.Block.Values[0].Args[1].Args[0] == v.Block.Values[0].Args[1].Args[1] => (VPSUBDMasked128Merging dst y x mask)

// A fused mask is reported as different only if the fallback is a
// variable the op and masks don't use; max(dst, dst) is dst.
(VPBLENDMDMasked128 dst (VPMAXSD128 dst dst) mask) => (VPMAXSDMasked128Merging dst dst dst (VPMOVVec32x4ToM <types.TypeMask> (VPMOVMToVec64x2 <types.TypeVec128> mask)))
(VPBLENDMDMasked128 dst (VPADDD128 x y) (VPCMPD128 [3] p q)) => (VPADDDMasked128Merging dst x y (VPCMPD128 [7] p q)) // want `fused mask: .* masks by \(VPCMPD128 \[7\] p q\), whose bit \d is 1 when \(VPCMPD128 \[3\] p q\)'s is 0`

// K logic in a fused mask.
(VPBLENDMDMasked128 dst (VPADDD128 x y) mask) => (VPADDDMasked128Merging dst x y (KNOTB mask)) // want `fused mask: VPBLENDMDMasked128 selects lane i by bit i of mask, but VPADDDMasked128Merging masks by \(KNOTB mask\), whose bit \d is \d when mask's is \d`
