// Explicit types.
(Lsh32x32 <t> x (Const32 [c])) => (Lsh32x64 x (Const64 <t> [int64(uint32(c))])) // want `\(Const64 <t> \.\.\.\) gives a 64-bit integer result the type t, a 32-bit integer`
(Lsh64x32 <t> x (Const32 [c])) => (Lsh64x64 x (Const64 <t> [int64(uint32(c))]))
(Lsh16x32 x (Const32 [c])) => (Lsh16x64 x (Const64 <typ.UInt64> [int64(uint32(c))]))
(Div32u x (Const32 [c])) => (Trunc64to32 (Rsh64Ux64 <typ.UInt64> (Avg64u (Lsh64x64 <typ.UInt64> (ZeroExt32to64 x) (Const64 <typ.UInt64> [32])) (Mul64 <typ.UInt32> (Const64 <typ.UInt64> [c]) (ZeroExt32to64 x))) (Const64 <typ.UInt64> [31]))) // want `\(Mul64 <typ.UInt32> \.\.\.\) gives a 64-bit integer result the type typ.UInt32, a 32-bit integer, but its consumer reads a 64-bit integer`
(Neg32F (Neg32F x)) => (Add32F <typ.Float64> x (Const32F <typ.Float32> [0])) // want `\(Add32F <typ.Float64> \.\.\.\) gives a 32-bit float result the type typ.Float64, a 64-bit float`

// A wider op may compute a narrower value for a narrow consumer.
(Div8 <t> x (Const8 [c])) => (Sub8 <t> (Rsh32x64 <t> (SignExt8to32 x) (Const64 <typ.UInt64> [c])) (Rsh32x64 <t> (SignExt8to32 x) (Const64 <typ.UInt64> [31])))

// Inherited root types.
(Lsh32x64 _ (Const64 [c])) && uint64(c) >= 32 => (Const64 [0]) // want `Const64 produces a 64-bit integer, but the Lsh32x64 it replaces is a 32-bit integer and its type is kept`
(Lsh16x64 _ (Const64 [c])) && uint64(c) >= 16 => (Const16 [0])
(Div64F x (Const64F [-1])) => (Neg32F x) // want `Neg32F produces a 32-bit float, but the Div64F it replaces is a 64-bit float` `Neg32F's argument 0 must be a 32-bit float, but x is a 64-bit float`
(Cvt64Fto64 (Const64F [c])) => (Const32 [int32(c)]) // want `Const32 produces a 32-bit integer, but the Cvt64Fto64 it replaces is a 64-bit integer`
(Div16 x y) => (Div32 (SignExt16to32 <typ.Int32> x) (SignExt16to32 <typ.Int32> y))

// Argument widths.
(Rsh32Ux8 x (Const8 [c])) => (Rsh32Ux64 x (Const32 <typ.UInt32> [int32(c)])) // want `Rsh32Ux64's argument 1 must be a 64-bit integer, but \(Const32 <typ.UInt32> \.\.\.\) is a 32-bit integer`
(Add16 (Const16 [0]) x) => (Add32 x (Const32 <typ.UInt32> [0])) // want `Add32's argument 0 must be a 32-bit integer, but x is a 16-bit integer`

// Matches that cannot happen.
(Rsh32Ux64 (Lsh32x64 x (Const32 [c])) (Const64 [d])) => x // want `Lsh32x64's argument 1 is always a 64-bit integer, so it is never Const32 \(a 32-bit integer\): the rule cannot match`
(IsInBounds (Rsh8Ux64 _ (Const64 [c])) (Const64 [d])) && 0 < c && c < 8 && 1<<uint(8-c)-1 < d => (ConstBool [true]) // want `IsInBounds's arguments always have the same type, so they are never Rsh8Ux64 \(an 8-bit integer\) and Const64 \(a 64-bit integer\)`
(IsInBounds (Rsh8Ux64 _ (Const64 [c])) (Const8 [d])) && 0 < c && c < 8 && 1<<uint(8-c)-1 < d => (ConstBool [true])
